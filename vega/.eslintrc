{
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "@react-native",
    "eslint:recommended"
  ],
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tsconfig.json"
      }
    },
    {
      "files": [
        "package.json",
        "kepler-compatibility.json"
      ],
      "parser": "jsonc-eslint-parser"
    }
  ],
  "ignorePatterns": [
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "package-lock.json"
  ],
  "rules": {
    "react-hooks/exhaustive-deps": "off",
    "react-native/no-inline-styles": "off",
    "no-void": "off",
    "no-bitwise": "off"
  }
}
