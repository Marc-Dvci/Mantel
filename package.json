{
  "name": "mantel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "description": "A Fire TV app that turns the living-room TV into a patient memory for a person living with dementia.",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "server": "tsx apps/server/src/main.ts",
    "dev": "tsx tools/demo/dev.ts",
    "demo": "tsx tools/demo/run.ts",
    "eval": "tsx tools/eval/matcher.ts",
    "bench": "tsx tools/sim/bench.ts",
    "tv:dev": "vite --config apps/tv/vite.config.ts",
    "family:dev": "vite --config apps/family/vite.config.ts",
    "build:web": "vite build --config apps/tv/vite.config.ts && vite build --config apps/family/vite.config.ts",
    "build:android-assets": "tsx tools/demo/copy-tv-assets.ts",
    "cdk:synth": "tsx infrastructure/cdk/app.ts",
    "check": "tsx tools/demo/doctor.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm eval && pnpm bench --dev"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1141.0",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-polly": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/credential-providers": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@aws/bedrock-token-generator": "^1.1.0",
    "express": "^5.1.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.5.4"
  }
}
